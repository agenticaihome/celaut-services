			echo "Asia/Shanghai"
			;;
		"PST8PDT" | "SystemV/PST8PDT")
			echo "America/Los_Angeles"
			;;
		"ROC")
			echo "Asia/Taipei"
			;;
		"ROK")
			echo "Asia/Seoul"
			;;
