			echo "Pacific/Pitcairn"
			;;
		"SystemV/YST9")
			echo "Pacific/Gambier"
			;;
		"SystemV/YST9YDT")
			echo "America/Anchorage"
			;;
		"Turkey")
			echo "Europe/Istanbul"
			;;
		"UCT")
			echo "Etc/UCT"
			;;
		"Universal" | "UTC" | "Zulu")
			echo "Etc/UTC"
			;;
